# GOAL-RELEVANCE DOMAIN MAPPING & SCORING RULES
# ------------------------------------------------------------------------------

[GOAL_DOMAIN_MATRIX]
Software Engineer = [programming, algorithms, data structures, database, web, operating systems, cloud, distributed systems, software engineering, system design]
AI/ML Engineer = [python, machine learning, deep learning, artificial intelligence, statistics, probability, data structures, vision, natural language, neural]
Data Scientist = [python, statistics, probability, data structures, database, sql, machine learning, data mining, big data, analytics, data wrangling]
Cybersecurity Analyst = [security, networks, cryptography, operating systems, linux, ethical hacking, penetration testing, forensics, cloud security, vulnerability]
Cloud Architect / DevOps = [operating systems, networks, cloud computing, distributed systems, devops, virtualization, microservices, containerization, scalable]
Mechanical Design Engineer = [graphics, cad, cam, mechanics, thermodynamics, machine design, kinematics, finite element, fea, robotics, manufacturing]
Civil / Structural Engineer = [surveying, mechanics, solid, structures, structural analysis, concrete, rcc, steel, geotechnical, foundation, urban]
Business / Financial Analyst = [business mathematics, accounting, finance, financial management, economics, operations, business analytics, strategy, statistics]
Robotics & Automation Engineer = [digital logic, microprocessors, microcontrollers, control systems, kinematics, dynamics, robotics, embedded, automation, ros]

# ------------------------------------------------------------------------------
# DYNAMIC PATHWAY SELECTION ALGORITHM
# ------------------------------------------------------------------------------
# Algorithm:
#   Inputs: (Department, Regulation, Current_Semester, Selected_Goal)
#   Remaining_Semesters = [Sem | Sem in (Current_Semester + 1 ... 8)]
#   For each Semester in Remaining_Semesters:
#       Candidates = Get_Available_Subjects(Department, Regulation, Semester)
#       Candidate_Scores = [Score_Subject_Relevance(Subject, Selected_Goal) for Subject in Candidates]
#       Top_Subject = ArgMax(Candidate_Scores) (Select ONLY ONE subject with highest domain relevance)
#       Why_Explanation = Generate_Goal_Aligned_Rationale(Top_Subject, Selected_Goal)
#       Roadmap.append({ Semester: Semester, MainSubject: Top_Subject, Why: Why_Explanation })
#   Capstone_Project = Generate_Goal_Aligned_Capstone(Department, Selected_Goal)
#   Roadmap.append({ Milestone: "After Semester 8", MainProject: Capstone_Project })
#   Return Roadmap
