# ==============================================================================
# OPTIMAL_PATHWAY_GENERATED.DAT
# Academic Pathway Intelligence & Goal-Specific Curriculum Navigator
# ==============================================================================
# Specification Version: 2.5.0
# Engine: Autonomous Multi-Department Goal-Driven Pathway Synthesis
# Description:
#   Self-contained academic roadmap engine that dynamically selects EXACTLY ONE
#   high-relevance curriculum subject per remaining semester based on:
#   Department + Regulation + Current Semester + Career Goal,
#   culminating in a goal-aligned Capstone / Main Project milestone after Sem 8.
# ==============================================================================

[ROADMAP_ENGINE_SPECIFICATION]
RULE_1_GOAL_SPECIFICITY = STRICT_CAREER_RELEVANCE_MATCH
RULE_2_SINGLE_SUBJECT_PER_SEMESTER = MANDATORY_EXACTLY_ONE
RULE_3_STARTING_SEMESTER = CURRENT_SEMESTER_PLUS_ONE_UP_TO_EIGHT
